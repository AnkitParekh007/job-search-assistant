{
  "name": "way-back-in-films",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "studio": "remotion studio",
    "audio": ".venv/bin/python tools/voiceover.py all && .venv/bin/python tools/visemes.py all && .venv/bin/python tools/score.py all && .venv/bin/python tools/mix.py all",
    "verify:release": ".venv/bin/python tools/verify_release.py",
    "check:source": ".venv/bin/python tools/check.py source",
    "render": "sh tools/render.sh",
    "check:render": ".venv/bin/python tools/check.py render",
    "build": "npm run verify:release && npm run audio && npm run check:source && npm run render && npm run check:render",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/cli": "4.0.545",
    "@remotion/google-fonts": "4.0.545",
    "@remotion/three": "^4.0.545",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.545",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/three": "^0.187.0",
    "typescript": "5.8.3"
  }
}
