# Optional macOS signing / notarization environment (Phase B — paid Apple Developer).
# Copy values into your shell or CI secrets. Never commit real credentials or .p12 files.
#
# Ad-hoc / developer-preview builds need NONE of these variables.

# Exact Keychain identity string from:
#   security find-identity -v -p codesigning
# Example: Developer ID Application: Example Inc (ABCD123456)
APPLE_SIGNING_IDENTITY=

# Optional Team ID (also used as Tauri providerShortName when set)
APPLE_TEAM_ID=

# notarytool keychain profile created via:
#   xcrun notarytool store-credentials "ai-job-search-notary" ...
APPLE_NOTARY_PROFILE=ai-job-search-notary

# Alternative notary auth (App Store Connect API key) — prefer over Apple ID password in CI
# APPLE_API_KEY_PATH=/path/to/AuthKey_XXXXXX.p8
# APPLE_API_KEY_ID=
# APPLE_API_ISSUER=

# CI-only: base64-encoded Developer ID .p12 (never commit the raw file)
# APPLE_CERTIFICATE=
# APPLE_CERTIFICATE_PASSWORD=

# Bundle id override for release builds (defaults to tauri.conf.json identifier)
# APPLE_BUNDLE_IDENTIFIER=app.jobzuu.aijobsearch
