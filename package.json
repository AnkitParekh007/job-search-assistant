{
  "name": "job-search-assistant",
  "private": true,
  "version": "0.1.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "market-site"
  ],
  "scripts": {
    "test": "npm run test -w @ai-job-search/core && npm run test -w ai-job-search-macos-apple-silicon",
    "test:core": "npm run test -w @ai-job-search/core",
    "build:features": "npm run build:features -w @ai-job-search/core",
    "build:market": "npm run build -w @ai-job-search/market-site",
    "dev:market": "npm run dev -w @ai-job-search/market-site",
    "dev:macos": "npm run tauri -w ai-job-search-macos-apple-silicon -- dev"
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "vitest": "^5.1.1"
  }
}
